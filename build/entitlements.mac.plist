<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The only entitlement current Electron needs under the hardened
         runtime: V8's JIT. Unsigned-executable-memory and DYLD environment
         variables were template leftovers that weaken the runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
